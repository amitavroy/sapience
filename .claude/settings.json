{
  "permissions": {
    "allow": ["Edit(./**)"],
    "deny": [
      "Edit(./.env)",
      "Edit(./secrets/**)",
      "Edit(./logs/**)",
      "Edit(./.venv/**)",
      "Edit(./.idea/**)",
      "Edit(./.vscode/**)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": ".claude/hooks/check.sh", "timeout": 300 }
        ]
      }
    ]
  }
}
